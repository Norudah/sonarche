{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://acoustid.org/*"
        }
      ]
    },
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart"
  ]
}
